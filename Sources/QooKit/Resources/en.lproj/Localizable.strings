/* Regular-expression safety warnings [SE-25]. Everything but a syntax error is a
   caution — the pattern still saves, but matching may become slow. */
"regex.warning.invalidSyntax" = "This isn't a valid regular expression: %@";
"regex.warning.quantifiedGroup" = "A quantified group also contains a quantifier or an alternation inside it (a shape like `(a+)+`). With some inputs, matching becomes extremely slow and is cut off at the time limit.";
"regex.warning.backreference" = "It contains a backreference (`\\1` or `\\k<name>`). Matching can become extremely slow, and backreferences are rarely needed when matching file names.";
"regex.warning.lookaround" = "It contains a lookahead or lookbehind (`(?=` `(?!` `(?<=` `(?<!`). Combined with quantifiers, matching can become slow.";
"regex.warning.fullWidthLiteral" = "It contains the full-width character %@. Matching folds full-width characters to half-width first, so this will never match. Write it half-width instead (to match a symbol literally, escape it as in `\\(`).";
"regex.warning.tooSlow" = "This regular expression becomes extremely slow with some inputs (%@ reached the time limit). It will be cut off during a scan, and this format will be disabled.";

/* Describes the input that reproduced the slowness; substituted into tooSlow above. */
"regex.sample.empty" = "an empty string";
"regex.sample.repeated" = "`%1$@` repeated %2$d times";
"regex.sample.excerpt" = "\"%@…\"";

