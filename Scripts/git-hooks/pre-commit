#!/bin/sh
#
# 私的なデータがコミットへ入るのを止める [MT-28〜MT-32]。
#
# **これが唯一の実効的な防壁である。** 内容の照合は、照合する相手（あなたの
# 蔵書、あなたの登録フォルダ名）が手元にしか無いので **CI では原理的に走れない**。
# CI に頼れない以上、コミットの瞬間に機械的に止めるしかない。
#
# 文書へ「コミット前に走らせること」と書くだけでは、**人間もエージェントも
# 忘れる**——実際、実蔵書の固有名詞が公開リポジトリへ入って push され、
# 8 日間公開され続けた。文書を hook に変えるのがこの仕掛けの目的。
#
# 有効化（クローンごとに 1 回）:
#     git config core.hooksPath Scripts/git-hooks
#
# 迂回は `git commit --no-verify`。**迂回したら、その理由と代わりに行った
# 確認を必ず記録すること。**
set -e

repo_root=$(git rev-parse --show-toplevel)
ran_any=0

# ① 貢献者自身の環境に由来する名前（登録フォルダ名・ユーザー名・ホームパス）。
#    **コーパスを必要としない**ので、引き継いだ人にもそのまま効く。
if [ -f "$repo_root/Scripts/check-personal-identifiers.swift" ]; then
    if swift "$repo_root/Scripts/check-personal-identifiers.swift"; then
        ran_any=1
    else
        status=$?
        if [ "$status" = "1" ]; then
            echo ""
            echo "!! 私的な名前が含まれているためコミットを中止した。"
            echo "   合成名へ置き換えてからやり直すこと。"
            exit 1
        fi
        # status 2 = 検査できなかった。**成功として扱わない。**
        echo "   （環境に由来する検査は実行できなかった）"
    fi
fi

# ② ゴールデンコーパスとの照合。持ち主にしか走らない。
if [ -f "$repo_root/Scripts/check-private-data-leak.swift" ]; then
    out=$(swift "$repo_root/Scripts/check-private-data-leak.swift" 2>&1) || {
        echo "$out"
        echo ""
        echo "!! 実蔵書の固有名詞が含まれているためコミットを中止した。"
        exit 1
    }
    echo "$out"
    # 「コーパスが無いので検査しない」は成功ではない。
    case "$out" in
        *"実コーパスが無いので検査しない"*) : ;;
        *) ran_any=1 ;;
    esac
fi

# **どちらの検査も実効的に動かなかったなら止める。**
#
# 「検査できなかった」を「問題なし」と読み替える取り違えが、この
# プロジェクトの漏洩事故の根本原因だった [MT-30]。保護が無い状態で
# 黙って通すくらいなら、止めて気づかせるほうがよい。
if [ "$ran_any" = "0" ]; then
    echo ""
    echo "!! 私的データの検査を 1 つも実行できなかったためコミットを中止した。"
    echo "   このリポジトリは実在の蔵書を扱う。保護が無い状態でのコミットは"
    echo "   意図的な判断であるべきで、既定であってはならない。"
    echo ""
    echo "   どちらかを用意すること:"
    echo "     - アプリを一度起動して登録フォルダを作る（環境由来の検査が動く）"
    echo "     - swift Scripts/extract-golden-corpus.swift（コーパス照合が動く）"
    echo ""
    echo "   承知のうえで進めるなら git commit --no-verify"
    exit 1
fi
