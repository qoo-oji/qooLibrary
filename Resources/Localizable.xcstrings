      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable a registered folder as a library from the folder tree first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダツリーで登録フォルダを「ライブラリとして有効にする」と、ここに現れます。"
