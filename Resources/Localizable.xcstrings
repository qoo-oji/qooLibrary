    "identityDecision.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files have the same name as a record in the library, but different contents — they were probably replaced. Keep the checkbox on to carry over what qooLibrary remembers (labels, rating, edited title, chosen cover)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のファイルは、ライブラリの記録と同じ名前で中身が違います。差し替えられたものと思われます。チェックを入れたままにすると、qooLibrary が覚えている内容（ラベル・評価・編集したタイトル・選んだカバー）を引き継ぎます。"
          }
        }
      }
    },
    "identityDecision.failed": {
