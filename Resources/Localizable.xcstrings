    "librarySettings.volumeFormats.ambiguousCaptureGroup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one capturing group, so it is unclear which one is the volume number. Use (?:…) for the others, or name the volume group (?<volume>…)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャグループが複数あり、どれが巻数か決まりません。巻数以外は (?:…) にするか、巻数を (?<volume>…) と名前付きにしてください。"
          }
        }
      }
    },
    "librarySettings.volumeFormats.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular expressions that read a volume number out of a name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前から巻数を読み取る正規表現です。"
          }
        }
      }
    },
    "librarySettings.volumeFormats.kindSeparator": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separator"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切り"
          }
        }
      }
    },
    "librarySettings.volumeFormats.kindVolume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "巻数"
          }
        }
      }
    },
    "librarySettings.volumeFormats.matchingHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The longest match wins; ties are broken by the order below. Listing “??vol” before “vol.??” alone would read “Work vol.01” as volume 01 and leave “Work vol.” as the series name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最長一致で決まり、同じ長さなら下の順序で決まります。順序だけで決めると「作品 第01巻」が「01巻」と読まれ、シリーズ名が「作品 第」になってしまいます。"
          }
        }
      }
    },
    "librarySettings.volumeFormats.noCaptureGroup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No capturing group for the volume number. Wrap the number in ( ), for example 第([0-9]+)巻. If this only marks where the series name ends, set the kind to Separator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "巻数を取り出すキャプチャグループがありません。巻数にあたる部分を ( ) で囲んでください（例: 第([0-9]+)巻）。シリーズ名を切るだけなら種別を「区切り」にしてください。"
          }
        }
      }
    },
    "librarySettings.volumeFormats.regexHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formats are regular expressions. The volume number is taken from the only capturing group, or from (?<volume>…). Full-width characters are folded to half-width before matching, so [0-9] also matches ０-９."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマットは正規表現です。巻数は唯一のキャプチャグループ、または (?<volume>…) から取ります。照合前に全角は半角へ畳まれるので、[0-9] は ０-９ にも一致します。"
          }
        }
      }
    },
    "librarySettings.volumeFormats.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
