{
  "sourceLanguage": "en",
  "strings": {
    "about.libarchiveAttribution": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses libarchive (BSD-2-Clause license)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "libarchive（BSD-2-Clause ライセンス）を使用しています。"
          }
        }
      }
    },
    "about.libarchiveSectionTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About zip / 7z / tar.gz Archive Extraction"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "zip / 7z / tar.gz アーカイブの展開について"
          }
        }
      }
    },
    "about.rarAttribution": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UnRAR is copyrighted by Alexander Roshal (RARLAB). The UnRAR source code, and any code that uses it, may not be used to develop a RAR-compatible archiver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UnRAR は Alexander Roshal 氏（RARLAB）による著作物です。UnRAR のソースコードおよびこれを利用するコードは、RAR 互換アーカイバの開発に使用してはなりません。"
          }
        }
      }
    },
    "about.rarBackend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app uses %@ to extract RAR/CBR archives in the current build configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリの RAR / CBR アーカイブの展開には、現在のビルド構成では %@ を使用しています。"
          }
        }
      }
    },
    "about.rarSectionTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
