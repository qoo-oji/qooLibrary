      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder's file system (%@) does not support persistent file IDs, so it cannot be registered (external volumes formatted as exFAT/FAT32, for example, are not supported)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダのファイルシステム（%@）は永続的なファイル ID に対応していないため登録できません（exFAT・FAT32 の外部ボリューム等は非対応です）。"
          }
        }
      }
    },
