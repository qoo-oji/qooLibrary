    "librarySettings.labelGroups.removeExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing “%@” also removes every label in it, along with the files’ links to those labels. This takes effect when you save."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除すると、そのグループのラベルと、ファイルとの紐づけもすべて消えます。保存したときに反映されます。"
          }
        }
      }
    },
    "librarySettings.labelGroups.removeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Label Group"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルグループの削除"
          }
        }
      }
    },
    "librarySettings.labelGroups.removeWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formats that refer to @labelgroup%lld will need to be edited too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@labelgroup%lld を参照しているフォーマットも直す必要があります。"
          }
        }
      }
    },
