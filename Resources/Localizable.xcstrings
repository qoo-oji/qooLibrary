    "librarySettings.labelGroups.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups that labels belong to. Filename formats refer to them by number, so renumbering changes what a format means."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルの入れ物です。ファイル名フォーマットは番号で参照するので、番号を付け替えるとフォーマットの意味が変わります。"
          }
        }
      }
    },
    "librarySettings.labelGroups.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
