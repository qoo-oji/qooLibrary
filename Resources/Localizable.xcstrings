    "backup.importFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing only adds and updates. It never deletes libraries, labels, or ratings. Files that have not been scanned yet are skipped — scan the library first, then import."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
