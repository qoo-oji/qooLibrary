      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access does not bypass qooLibrary's sandbox restrictions. To browse a volume or folder in the sidebar, grant access to it here — the same prompt also appears inline when you try to open a volume you haven't granted access to yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスを付与しても、qooLibraryのサンドボックス制限は回避されません。左ペインでボリューム・フォルダを閲覧するには、ここでアクセスを許可してください。未許可のボリュームを開こうとしたときにも同じ操作をその場で行えます。"
          }
        }
      }
    },
    "preferences.access.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted Volumes & Folders"
