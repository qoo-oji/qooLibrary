    "preferences.associations.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which app opens each format when you double-click or press Enter, and add any extension you'd like qooLibrary to manage (for example video formats). This only affects qooLibrary and doesn't change your Mac's system-wide default apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルクリックまたは Enter でファイルを開く際に使うアプリを選べます。qooLibrary で管理したい拡張子（例: 動画形式）も自由に追加できます。この設定は qooLibrary 内のみに影響し、Mac のシステム全体の既定アプリは変更しません。"
          }
