    "librarySettings.protectedTokens.anywhere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anywhere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置を問わない"
          }
        }
      }
    },
    "librarySettings.protectedTokens.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular expressions for text that contains delimiters but should be read as one piece, such as “(Complete Edition)” or a year in parentheses. Matches stay in the value; they are only kept from being split."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「(完全版)」や括弧に入った年号のように、区切り文字を含むけれど 1 かたまりとして読みたい範囲を表す正規表現です。一致した部分は値として残り、分割されなくなるだけです。"
          }
        }
      }
    },
    "librarySettings.protectedTokens.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular expression, e.g. \\((19|20)[0-9]{2}\\)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正規表現（例: \\((19|20)[0-9]{2}\\)）"
          }
        }
      }
    },
    "librarySettings.protectedTokens.prefix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先頭"
          }
        }
      }
    },
    "librarySettings.protectedTokens.suffix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the end"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾"
          }
        }
      }
    },
    "librarySettings.rescanExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings for “%@” were saved. Labels on files already in the library stay as they are until the library is scanned again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の設定を保存しました。すでに取り込んだファイルのラベルは、走査し直すまで変わりません。"
          }
        }
      }
    },
    "librarySettings.rescanLater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで"
          }
        }
      }
    },
    "librarySettings.rescanNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels you set by hand are kept. Only automatically assigned labels are recalculated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動で付けたラベルは保持されます。自動で付いたラベルだけが計算し直されます。"
          }
        }
      }
    },
    "librarySettings.rescanNow": {
