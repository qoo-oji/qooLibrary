          }
        }
      }
    },
    "preferences.scan.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "qooLibrary follows changes as they happen, but some changes cannot be detected: those made by another computer on a network share, and those made while qooLibrary was not running on volumes that keep no change history. A periodic full scan catches them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "qooLibrary は変更をその都度追いかけますが、検知できない変更もあります——ネットワーク共有で他のコンピュータが加えた変更と、変更履歴を持たないボリュームで qooLibrary の起動中でないときに加えられた変更です。定期フルスキャンがそれを拾います。"
          }
        }
      }
    },
    "preferences.scan.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodic Full Scan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期フルスキャン"
          }
        }
      }
