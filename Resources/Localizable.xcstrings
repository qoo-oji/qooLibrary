    "preferences.reset.backupFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels, ratings, manually edited titles, and library settings are written to a JSON file. Thumbnails and other data that a scan can rebuild are not included. Export before deleting anything below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベル・評価・手動で編集したタイトル・ライブラリ設定を JSON ファイルへ書き出します。サムネイルなど、スキャンで作り直せるデータは含みません。下の削除を行う前に書き出しておいてください。"
          }
        }
      }
    },
