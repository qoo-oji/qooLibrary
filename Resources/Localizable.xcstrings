    "librarySettings.basics.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A template only seeds these settings when the library is enabled. Everything here belongs to this library and can be changed at any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートは有効化のときに初期値を写すだけの雛形です。ここから先の設定はこのライブラリのもので、いつでも変えられます。"
          }
        }
      }
    },
    "librarySettings.basics.opensBookFolderWithApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open book folders with the associated app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックフォルダを関連付けアプリで開く"
          }
        }
      }
    },
    "librarySettings.basics.opensBookFolderWithAppHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book folder holds the images of a single book. When off, opening one shows the images inside it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックフォルダは 1 冊分の画像が入ったフォルダです。オフのときは、開くと中の画像が一覧表示されます。"
          }
        }
      }
    },
    "librarySettings.basics.seriesComposition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Series title format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シリーズ名の組み立て"
          }
        }
      }
    },
    "librarySettings.basics.thumbnailsAlwaysHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always hide thumbnails in this library"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリではサムネイルを常に非表示にする"
          }
        }
      }
    },
    "librarySettings.basics.typeName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library type name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリタイプ名"
          }
        }
      }
    },
    "librarySettings.basics.typeNameHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value matched by @librarytype. It must be written exactly as it appears in your filenames — for example “(Doujin CG Collection)” rather than “Doujin CG”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@librarytype が照合する値です。ファイル名に現れる表記と正確に一致させる必要があります（例:「同人CG」ではなく「同人CG集」）。"
          }
        }
      }
    },
    "librarySettings.delimiters.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Characters that mark a boundary between fields in a filename."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル名の中でフィールドの境目を示す文字です。"
          }
        }
      }
    },
    "librarySettings.delimiters.pairs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired delimiters"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペア型"
          }
        }
      }
    },
    "librarySettings.delimiters.separatorWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separators are off by default. Turning one on makes that character a boundary everywhere, including inside titles that happen to contain it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セパレータ型は既定で無効です。有効にすると、タイトルの中にたまたま含まれる同じ文字まで境目と見なされます。"
          }
        }
      }
    },
    "librarySettings.delimiters.separators": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separators"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セパレータ型"
          }
        }
      }
    },
    "librarySettings.discard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard Changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を破棄"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read metadata inside files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル内のメタデータを読む"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.enabledHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each file is opened once and the result is remembered, so later scans do not reopen files that have not changed. Turn this off for libraries whose files carry no metadata to make scanning faster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ファイルは一度だけ開き、結果を憶えます。変わっていないファイルは以後のスキャンで開き直しません。メタデータを持たない蔵書ではオフにすると走査が速くなります。"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the metadata stored inside the files themselves (ComicInfo.xml, EPUB, PDF) and use it in preference to what the file and folder names say."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル自身に埋め込まれたメタデータ（ComicInfo.xml・EPUB・PDF）を読み取り、ファイル名やフォルダ名から抽出した情報より優先して使います。"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.pendingCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d file(s) need a volume number decision."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 件のファイルで、巻数の判断が必要です。"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.pendingHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you decide, these files use the volume number taken from their file names."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断が済むまで、これらのファイルはファイル名から読み取った巻数を使います。"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認…"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.volumeSource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume number in ComicInfo.xml"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ComicInfo.xml の巻数"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.volumeSource.ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認する"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.volumeSource.number": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always use Number"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に Number を使う"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.volumeSource.volume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always use Volume"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に Volume を使う"
          }
        }
      }
    },
    "librarySettings.embeddedMetadata.volumeSourceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ComicInfo.xml has two elements that can hold a volume number, and applications disagree about which one to use: Komga treats Number as the volume, Kavita treats Volume as the volume. When a file has both and they differ, qooLibrary can ask you which one to trust."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ComicInfo.xml には巻数を表しうる要素が 2 つあり、どちらを使うかはアプリによって食い違います（Komga は Number、Kavita は Volume を巻数として扱います）。両方あって数字が違う場合に、どちらを採るかをここで決めます。"
          }
        }
      }
    },
    "librarySettings.extensions.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which files this library takes in. Anything outside the list is ignored during a scan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリが取り込むファイルを決めます。一覧に無い拡張子は走査で無視されます。"
          }
        }
      }
    },
    "librarySettings.extensions.image": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image extensions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像拡張子"
          }
        }
      }
    },
    "librarySettings.extensions.imageHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to decide whether a folder of images counts as one book."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像だけのフォルダを 1 冊として扱うかどうかの判定に使います。"
          }
        }
      }
    },
    "librarySettings.extensions.restoreDefaults": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
