    "folderTree.status.inTrashHint": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This registered folder is in the Trash. Put it back to use it again, or unregister it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この登録フォルダはゴミ箱にあります。元に戻すと再び使えます。使わない場合は登録を解除してください。"
          }
        }
      }
    },
    "folderTree.status.missingHint": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This registered folder could not be found. Choose a new location for it, or unregister it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この登録フォルダが見つかりません。場所を選び直すか、登録を解除してください。"
          }
        }
      }
    },
    "folderTree.status.nested": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder now overlaps another registered folder. Move one of them so they no longer contain each other."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの登録フォルダと重なっています。どちらかを移動して、互いに含まない場所にしてください。"
          }
        }
      }
    },
    "folderTree.status.offlineHint": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume is not connected. This folder becomes available again when you reconnect it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリュームが接続されていません。接続すると自動的に復帰します。"
          }
        }
      }
    },
    "folderTree.status.unsupportedFileSystem": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This volume cannot track files across moves, so labels, ratings and cover images will be lost when items move or are renamed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリュームはファイルを移動しても同一と判別できません。移動や改名のたびに、ラベル・評価・カバー画像との結びつきが失われます。"
          }
        }
      }
    },
    "folderTree.status.unsupportedFileSystemNamed": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This volume (%@) cannot track files across moves, so labels, ratings and cover images will be lost when items move or are renamed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリューム（%@）はファイルを移動しても同一と判別できません。移動や改名のたびに、ラベル・評価・カバー画像との結びつきが失われます。"
          }
        }
      }
    },
