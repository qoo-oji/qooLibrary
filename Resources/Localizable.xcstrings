    "preferences.scan.revalidateFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks which volumes are connected right now and brings libraries back online. Use this if a library still shows as disconnected after you reconnected its volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま接続されているボリュームを調べ直し、ライブラリをオンラインに戻します。ボリュームを繋ぎ直してもライブラリが未接続のままのときに使ってください。"
          }
        }
      }
