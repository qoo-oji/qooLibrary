    "preferences.advanced.exportFooter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The report is a zip archive containing the log files and a summary of your Mac, this build, and your registered folders. Nothing is ever sent over the network — share the file yourself if you're reporting a problem."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断情報は、ログファイルと、この Mac・ビルド・登録フォルダの概要をまとめた zip ファイルです。ネットワークへ送信されることは一切ありません。不具合を報告する際は、書き出したファイルをご自身で共有してください。"
          }
        }
      }
    },
    "preferences.advanced.exportHeader" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostic Report"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診断情報"
          }
        }
      }
    },
    "preferences.advanced.logFooter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "qooLibrary keeps a log file to help reproduce and report problems. Each level also includes the more severe ones above it, so “Debug” records the most detail. Logs rotate automatically and stay on this Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不具合の再現と報告に役立てるため、qooLibrary は動作の記録をファイルに残します。各レベルはそれより重大なものも含み、「デバッグ」がもっとも詳しく記録します。ログは自動的にローテーションされ、この Mac の中だけに保存されます。"
          }
        }
      }
    },
    "preferences.advanced.logHeader" : {
