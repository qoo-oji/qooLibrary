      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$d item(s) from an interrupted replace operation are still stored under a hidden name. Reconnect the volume and restart qooLibrary to try again.\n\n%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断された「置き換える」の項目 %1$d 件が、隠し名のまま残っています。ボリュームへ接続し直して qooLibrary を再起動すると、もう一度戻すことを試みます。\n\n%2$@"
          }
        }
      }
    },
