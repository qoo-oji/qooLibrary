    "librarySettings.volumeDecision.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files declare two different volume numbers. Compare each one with the file name and choose which value to use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルは 2 つの異なる巻数を宣言しています。ファイル名と見比べて、どちらの値を使うか選んでください。"
          }
        }
      }
    },
