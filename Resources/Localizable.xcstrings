      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files you uncheck are treated as different files and will not be asked about again. To decide later, press Cancel — nothing changes and you will be asked next time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックを外したものは別のファイルとして扱い、以後は確認しません。あとで決めたいときは「キャンセル」を押してください——何も変わらず、次回また確認します。"
          }
        }
      }
    },
