    "preferences.reset.libraryFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting removes the library from the database along with its labels, ratings, and settings. Your files are not touched. Libraries whose folder is offline, in the Trash, or missing can be deleted here too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除すると、そのライブラリとラベル・評価・設定がデータベースから消えます。ファイル自体には触れません。フォルダが取り出し済み・ゴミ箱の中・見つからない状態のライブラリも、ここから削除できます。"
