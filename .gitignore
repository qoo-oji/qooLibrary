# Swift / Xcode build artifacts
.build/
.swiftpm/
DerivedData/
# `xcodebuild` の成果物は通常 DerivedData へ出るが、設定次第でリポジトリ直下の
# `build/` にも出る。古い `build/` が残っていると、そちらの stale なアプリを
# 誤って起動する事故が起きるため（実際に起きた、CLAUDE.md 参照）無視しておく。
build/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Vendored third-party build output (regenerated by Scripts/build-*.sh,
# not committed to keep the repo small and builds reproducible from source;
# the build itself happens in a temp dir, not under ThirdParty/, see
# Scripts/build-libarchive.sh)
ThirdParty/libarchive/libarchive.xcframework/
ThirdParty/libarchive/*.log
ThirdParty/unrar/libunrar.xcframework/
ThirdParty/unrar/*.log

# Golden dataset samples that may contain real, copyrighted work/author names
# [MT-28]. Ignore contents (not the directory itself) so a README explaining
# the convention can still be tracked.
Tests/GoldenDataset/private/*
!Tests/GoldenDataset/private/README.md

# App data staging used by local spikes
Spikes/**/.staging/

# Xcode project generated by XcodeGen from project.yml — regenerate with
# `xcodegen generate`, don't hand-edit or commit the pbxproj.
qooLibrary.xcodeproj/
Sources/qooLibraryApp/Info-Generated.plist

# Editor-local config (auto-generated by IDE extensions, not shared).
.vscode/
